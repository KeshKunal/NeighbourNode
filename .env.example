# ================================================================
# NeighbourNode — Smart Community Resource & Skill Sharing Platform
# Academic Course: CSAEC59 — AEC-NoSQL (Ramaiah Institute of Technology)
# Core Database: MongoDB ONLY
# ================================================================

# ─── MongoDB (Atlas or Local) ──────────────────────────────────
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
# For Local MongoDB: mongodb://localhost:27017
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=neighbournode

# ─── Security & Authentication ──────────────────────────────────
JWT_SECRET_KEY=dev-secret-key-csaec59-neighbournode-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Frontend & CORS ────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── AI / Gemini (Optional) ─────────────────────────────────────
# When absent, deterministic rule-based and keyword matchmakers run automatically
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# ─── Telegram Bot (Optional) ────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ─── Google Calendar (Optional) ─────────────────────────────────
GOOGLE_CALENDAR_ID=
GOOGLE_CREDENTIALS_JSON=
GOOGLE_CREDENTIALS_PATH=

# ─── Media Storage (Optional) ───────────────────────────────────
IMAGE_STORAGE_CLOUD_NAME=
IMAGE_STORAGE_API_KEY=
IMAGE_STORAGE_API_SECRET=

# ─── Feature Flags ──────────────────────────────────────────────
MOCK_EXTERNAL_SERVICES=true
